# =============================================================================
# MONTI Web — plantilla pública (Vite)
# =============================================================================
# Copia a .env: cp .env.example .env
# Solo variables VITE_* (visibles en el navegador). Sin secretos de servidor.
# =============================================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEV_TEACHER_KEY=monti-local-teacher

VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_ANON_KEY

# Firebase (cliente web). Consola → Project settings → Your apps.
# La apiKey es pública en el bundle; restringe por dominio en Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_FEATURE_RAG=false
VITE_FEATURE_GENERATIVE_TUTOR=false
VITE_FEATURE_GENERATIVE_VOICE=false
VITE_FEATURE_SUPABASE_AUTH=false
VITE_FEATURE_SCHOOL_AUTH=false
# Login Google Workspace (Firebase Auth). Requiere API con
# MONTI_FEATURE_GOOGLE_LOGIN=true y FIREBASE_PROJECT_ID.
VITE_FEATURE_GOOGLE_LOGIN=false

VITE_VOICE_LANG=es-BO
VITE_ENABLE_BROWSER_SPEECH=true
