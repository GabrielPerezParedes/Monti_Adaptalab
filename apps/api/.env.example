# =============================================================================
# MONTI API — plantilla (segura para versionar)
# =============================================================================
# Copia a .env y completa los valores reales:
#   cp .env.example .env
# =============================================================================

# --- Aplicación --------------------------------------------------------------
MONTI_APP_NAME=MONTI
MONTI_APP_VERSION=1.1.0
MONTI_ENV=local
MONTI_LOG_LEVEL=INFO
MONTI_API_HOST=127.0.0.1
MONTI_API_PORT=8000
MONTI_PUBLIC_API_URL=http://127.0.0.1:8000
MONTI_PUBLIC_WEB_URL=http://localhost:5173
MONTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistencia (hito actual: SQLite) ---------------------------------------
MONTI_DATABASE_URL=sqlite:///./monti.sqlite3
# MONTI_DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# --- Auth de desarrollo (retirar en piloto escolar) --------------------------
MONTI_DEV_TEACHER_KEY=monti-local-teacher

# --- Supabase (Auth + PostgreSQL + Storage + pgvector) -----------------------
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=TU_JWT_SECRET
SUPABASE_DB_URL=postgresql+psycopg://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_POOL_URL=postgresql+psycopg://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:6543/postgres
SUPABASE_STORAGE_BUCKET_CORPUS=monti-corpus
SUPABASE_STORAGE_BUCKET_REPORTS=monti-reports

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-TU_OPENAI_API_KEY
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REQUEST_TIMEOUT_S=60
MONTI_AI_MAX_CALLS_PER_ATTEMPT=40
MONTI_AI_DAILY_BUDGET_USD=5.00

# --- RAG / LabSpec -----------------------------------------------------------
MONTI_RAG_TOP_K=6
MONTI_RAG_MIN_SCORE=0.25
MONTI_RAG_CORPUS_VERSION=racso-2009-ch8-v0
MONTI_LABSPEC_SCHEMA_VERSION=0.1
MONTI_RUBRIC_VERSION=45-v1-draft
MONTI_ATTEMPT_POLICY_VERSION=draft-1

# --- Física y evaluación -----------------------------------------------------
MONTI_PHYSICS_G_M_S2=10
MONTI_TARGET_TOLERANCE_M=0.5
MONTI_OBSERVED_RANGE_TOLERANCE_M=0.05
MONTI_MAX_SCORE=45

# --- Feature flags -----------------------------------------------------------
MONTI_FEATURE_RAG=false
MONTI_FEATURE_GENERATIVE_TUTOR=false
MONTI_FEATURE_GENERATIVE_VOICE=false
MONTI_FEATURE_SUPABASE_AUTH=false
MONTI_FEATURE_PDF_REPORTS=false

# --- Reportes / seguridad ----------------------------------------------------
MONTI_REPORT_LOCALE=es_BO
MONTI_REPORT_MAX_SUMMARY_WORDS=150
MONTI_DISCARD_AUDIO_AFTER_TRANSCRIBE=true
MONTI_SESSION_TOKEN_BYTES=32
MONTI_RATE_LIMIT_EVENTS_PER_MINUTE=120
